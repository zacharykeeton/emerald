{
  "name": "@emerald/daemon",
  "version": "0.1.825",
  "private": true,
  "description": "emmerd: owns PTYs, scrollback, sessions and layout; serves clients over a named pipe",
  "license": "MIT",
  "type": "module",
  "bin": {
    "emmerd": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --test --test-force-exit \"src/**/*.test.ts\"",
    "start": "node dist/main.js",
    "smoke": "node scripts/smoke.ts",
    "hooks": "node ../cli/dist/main.js hooks"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "@emerald/shared": "^0.1.0",
    "node-pty": "^1.1.0"
  }
}
