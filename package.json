{
  "name": "emerald",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for running and supervising several Claude Code sessions at once on Windows ARM64",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && npm test --workspaces --if-present",
    "smoke": "npm run build && npm run smoke -w @emerald/daemon",
    "daemon": "npm run start -w @emerald/daemon",
    "demo": "node demo/reset.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^7.0.2"
  }
}
